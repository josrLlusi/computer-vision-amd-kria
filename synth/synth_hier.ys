# per-module (hierarchical) resource breakdown, YOLO26n head @320px, K=300 LANES=16   (run from project root)
read_verilog -sv rtl/ram_tdp.v rtl/topk_sorter.v rtl/conv_engine.v rtl/det_post.v rtl/yolo26_head_core.v rtl/yolo26_head_axil.v rtl/yolo26_head_kria_top.v
hierarchy -check -top yolo26_head_kria_top
synth_xilinx -top yolo26_head_kria_top -family xcup
tee -o synth/stat_hier.txt stat -top yolo26_head_kria_top
