# Yosys resource estimate for the Kria K26 (Zynq UltraScale+ = family xcup). Run from the project root.
read_verilog -sv rtl/ram_tdp.v rtl/topk_sorter.v rtl/conv_engine.v rtl/det_post.v rtl/yolo26_head_core.v rtl/yolo26_head_axil.v rtl/yolo26_head_kria_top.v
hierarchy -check -top yolo26_head_kria_top
synth_xilinx -top yolo26_head_kria_top -family xcup -flatten
tee -o synth/stat.txt stat
